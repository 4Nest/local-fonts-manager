# 复制为 .env 后修改。Compose 会自动读取 .env。
# WebUI 直接打开；API Token 在网页“设置”中修改、复制或重置。
FONT_LIBRARY_PATH=/path/to/Fonts
FONT_STATE_PATH=/vol3/docker/local-fonts-manager/state
# 自动入库数据库使用独立持久化目录，不要与 WebUI 状态混用。
FONT_INGEST_STATE_PATH=/vol3/docker/local-fonts-manager/ingest-state
FONT_MANAGER_PORT=8765
PUID=1000
PGID=1001

